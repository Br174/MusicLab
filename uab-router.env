# Universal APK Builder - provider routing for MusicLab
UAB_PROJECT_NAME="MusicLab"
UAB_PROVIDER_ORDER="local,github-actions,codemagic"
UAB_BRANCH="universal-apk-builder"

# Mandatory artifact-first lookup. Reuse the current ready APK/ZIP instead of rebuilding.
UAB_REUSE_READY_ARTIFACTS="on"
UAB_MANIFEST_REPOSITORY="Br174/Chatgpt"
UAB_MANIFEST_BRANCH="main"
UAB_MANIFEST_PATH="uab-artifacts/{project}/latest.json"
# Changes limited to UAB/build-delivery infrastructure do not invalidate an already-built app binary.
UAB_ARTIFACT_REUSE_IGNORE_REGEX="^(tools/universal-apk-builder/|uab-router\\.env$|codemagic\\.yaml$|\\.github/)"

# Fast provider fallback.
UAB_GITHUB_DISCOVERY_TIMEOUT_SECONDS="30"

UAB_CODEMAGIC_WORKFLOW="uab-musiclab-lab"
UAB_GITHUB_REPOSITORY="Br174/MusicLab"
UAB_GITHUB_WORKFLOW="build_quick.yml"
# Conservative free allowance guard for GitHub Free. Set to 3000 only if the repository owner uses GitHub Pro.
UAB_GITHUB_INCLUDED_MINUTES="2000"
UAB_PAID_FALLBACK="never"
