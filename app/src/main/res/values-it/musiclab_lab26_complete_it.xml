    <string name="qobuz_quality_cd_desc">Lossless. Impostazione predefinita consigliata.</string>
    <string name="qobuz_quality_hires">Hi-Res (FLAC fino a 24 bit / 192 kHz)</string>
    <string name="qobuz_quality_hires_desc">Lossless con la massima profondità in bit e frequenza di campionamento disponibili.</string>
