# UAB-CORE-V1 project adapter for MusicLab
UAB_ENGINE_VERSION="UAB-CORE-V1"
UAB_PROJECT_NAME="MusicLab"
UAB_PROJECT_CLASS="android"
UAB_MOTHER_REF="stable-musiclab-lab01-build52"
UAB_LAB_PREFIX="lab/"
UAB_CANDIDATE_PREFIX="candidate/"
UAB_MOTHER_PREFIX="mother/"
UAB_RELEASE_MODE="immutable-mother"
UAB_CORE_REGRESSION_GATES="app startup,audio playback,track loading,search/navigation,requested feature,package/signing sanity"

UAB_TASK=":app:assembleFossDebug"
UAB_APK_GLOB="app/build/outputs/apk/foss/debug/*.apk"
UAB_FILE_VERSION="01"
UAB_OUTPUT_NAME="MusicLab-LAB-${UAB_FILE_VERSION}"

# Persistent build acceleration
UAB_GRADLE_ARGS="--build-cache -x lint"
UAB_PRE_BUILD_SCRIPT=".uab/pre-build.sh"

# LABs install in parallel and never replace the Mother.
UAB_PARALLEL_INSTALL="on"
UAB_APPLICATION_ID_BASE="it.verlezza.musiclab.lab"
UAB_APPLICATION_ID_ENV="METROLIST_APPLICATION_ID"
UAB_APP_NAME_BASE="MusicLab LAB"
UAB_APP_NAME_ENV="METROLIST_APP_NAME"

# LAB/CANDIDATA are temporary artifacts. Permanent Release is created only after approved Mother promotion.
UAB_LAB_PERMANENT_RELEASE="off"
UAB_CANDIDATE_PERMANENT_RELEASE="off"
UAB_MOTHER_IMMUTABLE_RELEASE="on"
UAB_LEGACY_LATEST_RELEASE="deprecated"

export PULL_REQUEST="false"
