# Project adapter for Universal APK Builder
UAB_TASK=":app:assembleFossDebug"
UAB_APK_GLOB="app/build/outputs/apk/foss/debug/*.apk"

# User-facing LAB identity for this test line.
UAB_FILE_VERSION="SWIPE-FLUID-PLAY-01"
UAB_OUTPUT_NAME="MusicLab-LAB-${UAB_FILE_VERSION}"
UAB_BUILD_ID="swipefluidplay01"

UAB_GRADLE_ARGS="-x lint --build-cache"
UAB_PRE_BUILD_SCRIPT=".uab/pre-build.sh"

# Parallel-install contract. The UAB core creates a dedicated LAB identity,
# while this project adapter maps it to MusicLab's existing Gradle env vars.
UAB_PARALLEL_INSTALL="on"
UAB_APPLICATION_ID_BASE="it.verlezza.musiclab.lab"
UAB_APPLICATION_ID_ENV="METROLIST_APPLICATION_ID"
UAB_APP_NAME_BASE="MusicLab LAB Swipe Fluido"
UAB_APP_NAME_ENV="METROLIST_APP_NAME"

export PULL_REQUEST="false"
