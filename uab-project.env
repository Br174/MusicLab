# Project adapter for Universal APK Builder
UAB_TASK=":app:assembleFossDebug"
UAB_APK_GLOB="app/build/outputs/apk/foss/debug/*.apk"

# Bruno-facing update-family identity.
# Same active LAB Family 01: this APK must update the installed LAB 49 aggiornamento in place.
# Future revisions (LAB 49 aggiornamento, LAB 57 aggiornamento, ...) MUST keep the same
# applicationId + signing profile and only increase versionCode / visible revision name.
UAB_FILE_VERSION="LAB57_AGGIORNAMENTO"
UAB_OUTPUT_NAME="MusicLab-LAB57-aggiornamento"

UAB_GRADLE_ARGS="-x lint"
UAB_PRE_BUILD_SCRIPT=".uab/pre-build.sh"

# Stable Android update family. Do NOT add a per-build/random suffix.
UAB_PARALLEL_INSTALL="off"
UAB_UPDATE_FAMILY_MODE="lab"
UAB_UPDATE_FAMILY_ID="01"
UAB_UPDATE_FAMILY_APPLICATION_ID="it.verlezza.musiclab.labupdate01"
UAB_UPDATE_FAMILY_SIGNING_PROFILE="musiclab-lab-family-01-test"
UAB_UPDATE_FAMILY_ORIGIN_SHA="8a458f8f4d1e560736d81f78de551664998619f9"
UAB_UPDATE_FAMILY_VISIBLE_NAME="LAB 57 aggiornamento"
UAB_UPDATE_FAMILY_VERSION_CODE="5701"
UAB_UPDATE_FAMILY_CERT_SHA256="9A:2F:67:CF:B3:C1:99:83:68:13:AD:DB:F7:BD:FB:0F:A6:5E:DC:76:5F:FA:CE:4B:6D:F9:49:0B:B0:96:27:49"

# Stable LAB-only signing material. Test key only; never use as CANDIDATA/MADRE production key.
UAB_FAMILY_SIGNING_KEY_B64_FILE=".uab/signing/musiclab-lab-family-01.jks.b64"
UAB_FAMILY_KEYSTORE_PASSWORD="android"
UAB_FAMILY_KEY_ALIAS="musiclab_lab_family_01"
UAB_FAMILY_KEY_PASSWORD="android"

# These are read directly by app/build.gradle.kts.
export METROLIST_APPLICATION_ID="it.verlezza.musiclab.labupdate01"
export METROLIST_APP_NAME="MusicLab LAB 57 aggiornamento"
export MUSICLAB_VERSION_CODE="5701"
export MUSICLAB_VERSION_NAME="0.9.8-lab57-aggiornamento"

export PULL_REQUEST="false"
