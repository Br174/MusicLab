# Project adapter for Universal APK Builder
UAB_TASK=":app:assembleFossDebug"
UAB_APK_GLOB="app/build/outputs/apk/foss/debug/*.apk"

# Candidate delivery identity. This branch is built and tested separately from MADRE LAB42, CANDIDATA and earlier LABs.
UAB_FILE_VERSION="LAB43"
UAB_OUTPUT_NAME="MusicLab-LAB43"

UAB_GRADLE_ARGS="-x lint"
UAB_PRE_BUILD_SCRIPT=".uab/pre-build.sh"

# Parallel-install contract. The UAB core creates a unique Candidate identity on every build,
# while this project adapter maps that generic identity to MusicLab's existing Gradle env vars.
UAB_PARALLEL_INSTALL="on"
UAB_APPLICATION_ID_BASE="it.verlezza.musiclab.lab43"
UAB_APPLICATION_ID_ENV="METROLIST_APPLICATION_ID"
UAB_APP_NAME_BASE="MusicLab LAB43"
UAB_APP_NAME_ENV="METROLIST_APP_NAME"

export PULL_REQUEST="false"
