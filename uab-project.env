# Project adapter for Universal APK Builder
UAB_TASK=":app:assembleFossDebug"
UAB_APK_GLOB="app/build/outputs/apk/foss/debug/*.apk"
UAB_OUTPUT_NAME="MusicLab-LAB"
UAB_GRADLE_ARGS="-x lint"
UAB_PRE_BUILD_SCRIPT=".uab/pre-build.sh"

# Project-specific overrides consumed by app/build.gradle.kts.
export METROLIST_APPLICATION_ID="it.verlezza.musiclab.lab"
export METROLIST_APP_NAME="MusicLab LAB"
export PULL_REQUEST="false"
