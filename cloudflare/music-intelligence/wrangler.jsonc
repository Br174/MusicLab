{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "musiclab-music-intelligence",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "vars": {
    "ENGINE_VERSION": "1.0.0",
    "GEMINI_MODEL": "gemini-2.5-flash-lite",
    "MAX_DISCOVERY_RESULTS": "150"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "musiclab-intelligence-db",
      "database_id": "INSERIRE_DATABASE_ID_DOPO_LA_CREAZIONE"
    }
  ]
}
