# UAB-CORE-V1.1 thin adapter: MusicLab
UAB_ENGINE_VERSION="UAB-CORE-V1.1"
UAB_PROJECT_NAME="MusicLab"
UAB_PROJECT_CLASS="android"
UAB_MOTHER_REF="mother/musiclab-lab19-final"
UAB_MOTHER_SOURCE_COMMIT="6f3efabd77d6e0a918b91091bb1862986d1dc5fc"
UAB_LAB_PREFIX="lab/"
UAB_CANDIDATE_PREFIX="candidate/"
UAB_MOTHER_PREFIX="mother/"
UAB_BUILD_ROUTE="GitHub Actions / Gradle :app:assembleFossDebug"
UAB_CACHE_MODE="gradle"
UAB_RELEASE_MODE="immutable-mother"
UAB_CORE_REGRESSION_GATES="app startup,audio playback,track loading,search/navigation,requested feature,package/signing sanity"
UAB_ANDROID_PACKAGE_STRATEGY="parallel-lab"
UAB_SIGNING_STRATEGY="ephemeral-lab; stable-on-promoted-mother"
UAB_PATCH_REPACK="forbidden"
UAB_OUTPUT_TYPES="apk,zip,sha256"
UAB_LAB_SCOPE="one requested modification or one small inseparable change-set"
UAB_CANDIDATE_METHOD="fresh from exact LAB source Mother; replay exact approved LAB change-set"
UAB_CANDIDATE_DELIVERY_RULE="every Candidate is rebuilt from Mother + approved LAB method, gets its own APK+ZIP, and requires Bruno test before Mother promotion"
UAB_MOTHER_PROMOTION_METHOD="new Mother source ref points to exact approved Candidate source SHA"
UAB_PROMOTION_TRACE_REQUIRED="on"
UAB_LEGACY_LATEST_RELEASE="deprecated"
